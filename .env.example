# Environment Variables Template
# Login sessions survive local restarts using data/.auth_session_secret.
# For deployment replicas, configure the same strong secret on every worker:
# AUTH_SECRET_KEY=<at least 32 random characters>
# AUTH_SECRET_FILE=/persistent/private/path/session-secret
# Active LLM Provider: 'openrouter' (default), 'groq', or 'ollama'
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Local Ollama Configuration (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq Cloud API Configuration (if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_SECONDARY_API_KEY=
GROQ_TERTIARY_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Keep output reservations below your account's output-tokens-per-minute limit.
GROQ_MAX_OUTPUT_TOKENS=800
# Complete CV profiles need more space than individual screening decisions.
GROQ_PARSER_MAX_OUTPUT_TOKENS=8192
# Pause a batch safely if providers do not recover within this waiting budget.
PARSER_PROVIDER_WAIT_SECONDS=90
# Total cooldown wait per screening run; longer outages remain retryable.
SCREENING_PROVIDER_WAIT_SECONDS=30

# Google Gemini Configuration (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_SECONDARY_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-flash-latest

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Arize Phoenix Observability
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
ENABLE_PHOENIX_TRACING=true

# Application Settings
SCREENING_RERANKER_TIMEOUT_SECONDS=30
SCREENING_RERANKER_LOAD_TIMEOUT_SECONDS=180
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# Cohere API Configuration
COHERE_API_KEY=your_cohere_api_key_here
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_MODEL=command-r-08-2024
